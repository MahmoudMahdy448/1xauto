  "cards": [
    {
      "dot": "cyan",
      "title": "Delivery Rules",
      "items": [
        "A number is claimed in the shared ledger immediately before its PNG leaves",
        "A delivery that reaches nobody is released for retry; a partial one is reported",
        "Each PNG goes to the admin chat and the numbers channel, never the channel alone"
      ]
    },
    {
      "dot": "rose",
      "title": "Alerting Rules",
      "items": [
        "Silent by default: alerts go to the admin chat only, plus one 09:00 Cairo all-clear",
        "5 failures in 15 min is a storm; one screenshot per new error, capped at 10 per hour",
        "Quiet 00:00–08:00 Cairo buffers yellow alerts; red alerts pass through; recovery closes every incident with a green resolution"
      ]
    },
    {
      "dot": "emerald",
      "title": "Control & Audit",
      "items": [
        "Only the status bot calls getUpdates; it restarts shard-1 or linebet only when dead, and never melbet",
        "Liveness is event staleness, not process listing: 5 min is silent, 15 min is stalled"
      ]
    }
  ]
