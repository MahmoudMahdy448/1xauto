ONEXBET_USERNAME=your-account-username
ONEXBET_PASSWORD=your-account-password
ONEXBET_SURNAME=your-account-surname
# PROXY_URL=http://user:pass@host:port (optional)
# MAX_RETRIES=2 (optional, default 2: 1 initial + 1 retry)
# ALLOW_LIVE_RUN=true (required for real runs; DRY_RUN=true bypasses navigation without it)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF... (optional, for Telegram notifications)
# TELEGRAM_CHAT_ID=123456789 (optional, chat/group to receive run summaries)
# LOW_MEMORY=true (optional, ONLY for 1 GiB VMs: Chromium --single-process --disable-gpu).
# --no-sandbox is auto-added on Linux (Azure/OCI block Chromium's sandbox); not needed on Windows.
# Leave unset on ≥2 GiB VMs (e.g. a paid-month B2as_v2 8 GiB) so the batch runs with full memory.
# vm-setup.sh sets this automatically from RAM (auto-detect; override with LOW_MEMORY=1/0).
# END_INDEX=92 (optional, sharding: process accounts up to this index; START_INDEX sets the lower bound)
# STATE_FILE=./state-shard-1.json (optional, per-shard state file so multiple VMs don't clobber each other)
# COOLDOWN_MINUTES=30 (optional, used by npm run loop between re-runs)
