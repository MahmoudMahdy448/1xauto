ONEXBET_USERNAME=your-account-username
ONEXBET_PASSWORD=your-account-password
ONEXBET_SURNAME=your-account-surname
# PROXY_URL=http://user:pass@host:port (optional)
# MAX_RETRIES=2 (optional, default 2: 1 initial + 1 retry)
# ALLOW_LIVE_RUN=true (required for real runs; DRY_RUN=true bypasses navigation without it)
