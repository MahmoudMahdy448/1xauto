ONEXBET_USERNAME=your-account-username
ONEXBET_PASSWORD=your-account-password
ONEXBET_SURNAME=your-account-surname
# PROXY_URL=http://user:pass@host:port (optional)
# MAX_RETRIES=2 (optional, default 2: 1 initial + 1 retry)
# ALLOW_LIVE_RUN=true (required for real runs; DRY_RUN=true bypasses navigation without it)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF... (optional, for Telegram notifications)
# TELEGRAM_CHAT_ID=123456789 (optional, chat/group to receive run summaries + deduped screenshots)
# SCREENSHOTS_DIR=./screenshots/shard-1 (optional, per-shard screenshots dir; set by register-shards.sh)
# RUN_SUMMARY_FILE=./run-summary-shard-1.json (optional, per-shard summary; set by register-shards.sh)
# EXCEL_FILE=./extracted_numbers-shard-1.xlsx (optional, per-shard excel; set by register-shards.sh)
# LOW_MEMORY=true (optional, ONLY for 1 GiB VMs: Chromium --single-process --disable-gpu).
# --no-sandbox is auto-added on Linux (Azure/OCI block Chromium's sandbox); not needed on Windows.
# Leave unset on ≥2 GiB VMs (e.g. a paid-month B2as_v2 8 GiB) so the batch runs with full memory.
# vm-setup.sh sets this automatically from RAM (auto-detect; override with LOW_MEMORY=1/0).
# END_INDEX=92 (optional, sharding: process accounts up to this index; START_INDEX sets the lower bound)
# STATE_FILE=./state-shard-1.json (optional, per-shard state file so multiple VMs don't clobber each other)
# COOLDOWN_MINUTES=30 (optional, used by npm run loop between re-runs)

# --- Deposit gate (lib/deposit-gate.js, run-loop.js, tests/login.spec.js) ---
# When Vodafone is marked "not available due to technical issues", the pass
# stops and the loop only runs one cheap probe account until it comes back.
# GATE_ENABLED=false (optional; set on melbet, which has no Vodafone method)
# GATE_FILE=./deposit-gate.json (shared by all 1xbet shards, written atomically)
# GATE_SHOTS_DIR=./screenshots/gate (evidence, kept out of the shard dirs so the realtime sender never posts it)
# GATE_CHECK_LADDER_MINUTES=5,15,15,15 (first check, then every probe; last value repeats)
# GATE_REMINDER_MINUTES=60 (one "still down" message per hour while gated)
# GATE_FLAP_SUPPRESS_MINUTES=5 (a flap inside this window does not re-alert)
# GATE_PROBE_INDICES_SHARD_1=22,98,135 (known-good accounts, rotated; falls back to START_INDEX)
# GATE_PROBE_INDICES_SHARD_2=245,247,252
# GATE_PROBE_INDICES=22 (generic fallback when no per-shard list is set)
# GATE_LOCK_FILE=./deposit-gate.probe.lock (one shard probes at a time; stale after 10 min)

# --- IP-block circuit breaker (lib/site-block.js) ---------------------------
# 1xbet answers logins with "Suspicious activity detected. Try again later."
# when too many accounts come from one IP. That is site-wide, so the whole farm
# parks instead of spending the rest of the range. The wait grows while it
# repeats and is cleared by the first successful login.
# SITE_BLOCK_FILE=./site-block.json (shared by both shards)
# SITE_BLOCK_LADDER_MINUTES=15,30,60,120 (wait per consecutive block, last repeats)
# ACCOUNT_DELAY_MS=2000 (pause between accounts; raise it to lower the login burst)

# --- Monitoring layer (scripts/monitor-agent.mjs, status-bot.mjs) -----------
# Alerts always go to TELEGRAM_CHAT_ID, never TELEGRAM_CHANNEL_ID.
# TELEGRAM_CHANNEL_ID=-100... (optional, channel that receives screenshots only)
# EVENTS_DIR=./events (JSONL event logs; one file per service/role/instance/day)
# MONITOR_STATE_FILE=./monitor-state.json
# ALERT_CONTROL_FILE=./alert-control.json (/mute state)
# ALERT_STORM_COUNT=5 / ALERT_STORM_MINUTES=15 (one storm alert, no per-account pings)
# ALERT_STALL_WARN_MINUTES=5 / ALERT_STALL_MINUTES=15 (silent -> stalled)
# ALERT_PHOTO_CAP_PER_HOUR=10 (extra error screenshots arrive as text)
# ALERT_QUIET_START_HOUR=0 / ALERT_QUIET_END_HOUR=8 (Cairo: warnings buffered, criticals pass)
# ALERT_DAILY_PING_HOUR=9 (one all-clear line per day, Cairo)
# MONITOR_TICK_MS=15000 (agent loop interval)
# MONITOR_STARTUP_GRACE_MINUTES=5 (ignore events older than this on startup)
# MONITOR_BACKOFF_MS=5000,15000,45000,120000 (supervisor restart backoff)
# MONITOR_CRASH_WINDOW_MINUTES=10 / MONITOR_MAX_CRASHES=3 (then it gives up)
# STATUS_BACKLOG_MAX_AGE_SECONDS=60 (older commands queued while the bot was down are skipped)
# MONITOR_TZ=Africa/Cairo (all report times)

